# 请运行 xianyu-workbench init 随机生成，不要直接复制占位令牌启动。
XY_ADMIN_TOKEN=GENERATE_WITH_INIT
XY_AGENT_TOKEN=GENERATE_WITH_INIT
XY_VAULT_KEY=GENERATE_WITH_INIT
XY_DATA_DIR=./data
XY_LIVE_ENABLED=false
XY_WORKER_ENABLED=true
XY_OPERATION_TIMEOUT=120
XY_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# 管理员部署配置，不开放给 Agent。详见 docs/BROWSER.md。
XY_BROWSER=auto
XY_BROWSER_EXECUTABLE=
# 留空关闭 CDP；启用必须同时填写固定工作台账号 ID 与平台 UID，仅支持 search。
XY_BROWSER_CDP_ENDPOINT=
XY_BROWSER_CDP_ACCOUNT_ID=
XY_BROWSER_CDP_UID=
